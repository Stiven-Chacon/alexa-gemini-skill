{
  "name": "asistente-nova-workspace",
  "private": true,
  "description": "Dev tooling for the asistente nova Alexa skill. Not deployed: Amazon only installs lambda/package.json.",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "ask:gemini": "node lambda/scripts/test-gemini.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "ask-sdk-core": "^2.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.1",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.10.1"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/lambda/tests"
    ],
    "collectCoverageFrom": [
      "lambda/src/**/*.js"
    ]
  }
}
